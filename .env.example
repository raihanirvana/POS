HOST=127.0.0.1
PORT=3001
WEB_PORT=5173
NODE_ENV=development
# Tampilkan catatan data sementara di halaman masuk (diaktifkan untuk Render Free).
VITE_DEMO_EPHEMERAL_STORAGE=false
DATABASE_PATH=./data/seduh.sqlite
# Umur ruang demo dan sesinya dalam menit (default 12 jam).
DEMO_TTL_MINUTES=720
# Isi hanya bila berjalan di belakang reverse proxy HTTPS, misalnya 1 atau loopback.
TRUST_PROXY=false
# Origin HTTP(S) tambahan, pisahkan koma; tanpa path/kredensial/query/fragment.
ALLOWED_ORIGINS=
# Batas demo publik per IP dan kapasitas ruang demo.
DEMO_SESSION_LIMIT=30
API_RATE_LIMIT=300
DEMO_MAX_WORKSPACES=500
